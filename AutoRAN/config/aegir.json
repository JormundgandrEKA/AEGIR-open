{
  "tool_name": "aegir-ran",
  "default_max_requests": 500,
  "ncbi_daytime_threshold": 1000,
  "pubmed_batch": 200,
  "min_fulltext_grade": "D-",
  "min_redistribute_grade": "B-",
  "rate": {
    "clinicaltrials.gov": {
      "per_minute": 40
    },
    "eutils.ncbi.nlm.nih.gov": {
      "per_second_nokey": 3,
      "per_second_key": 10
    },
    "www.ncbi.nlm.nih.gov": {
      "per_second_nokey": 3,
      "per_second_key": 10
    },
    "pmc.ncbi.nlm.nih.gov": {
      "per_second_nokey": 3,
      "per_second_key": 10
    },
    "default": {
      "per_minute": 30
    },
    "www.ebi.ac.uk": {
      "per_minute": 50
    },
    "datasets-server.huggingface.co": {
      "per_minute": 20
    },
    "huggingface.co": {
      "per_minute": 30
    }
  },
  "source_grades": {
    "ctgov_search": "A+",
    "ctgov_study": "A+",
    "ctgov_history": "A-",
    "ctgov_references": "A",
    "pubmed_metadata": "A-",
    "epmc_licence": "B"
  },
  "backoff": {
    "www.ebi.ac.uk": [
      30,
      60,
      120
    ],
    "datasets-server.huggingface.co": [
      30,
      60,
      120
    ]
  },
  "demo_output_dir": "demo/labels"
}
